{
  "entities": {
    "users": {
      "title": "users",
      "description": "Registered attendee users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "registeredAt": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "status": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "emailVerified": { "type": "boolean" }
      },
      "required": ["email", "fullName"]
    },
    "organizers": {
      "title": "organizers",
      "description": "Event Organizers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationName": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "organizerType": { "type": "string" },
        "country": { "type": "string" },
        "registeredAt": { "type": "string" },
        "status": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "payoutAccount": { "type": "object" },
        "eventsCount": { "type": "number" }
      },
      "required": ["email", "organizationName"]
    },
    "events": {
      "title": "events",
      "description": "Published Events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "organizerName": { "type": "string" },
        "organizerId": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "venueName": { "type": "string" },
        "address": { "type": "string" },
        "image": { "type": "string" },
        "bannerImage": { "type": "string" },
        "description": { "type": "string" },
        "featured": { "type": "boolean" },
        "ticketTiers": { "type": "array" },
        "tags": { "type": "array" },
        "currency": { "type": "string" },
        "country": { "type": "string" }
      },
      "required": ["title", "category", "date"]
    },
    "orders": {
      "title": "orders",
      "description": "Ticket Orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "tickets": { "type": "array" }
      },
      "required": ["eventId", "customerEmail", "totalAmount"]
    },
    "tickets": {
      "title": "tickets",
      "description": "Issued Ticket Passes",
      "type": "object",
      "properties": {
        "ticketCode": { "type": "string" },
        "orderId": { "type": "string" },
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDate": { "type": "string" },
        "eventTime": { "type": "string" },
        "venueName": { "type": "string" },
        "tierName": { "type": "string" },
        "attendeeName": { "type": "string" },
        "attendeeEmail": { "type": "string" },
        "attendeePhone": { "type": "string" },
        "pricePaid": { "type": "number" },
        "purchaseDate": { "type": "string" },
        "status": { "type": "string" },
        "checkedInAt": { "type": "string" },
        "scannedByGate": { "type": "string" },
        "gateNumber": { "type": "string" }
      },
      "required": ["ticketCode", "orderId", "eventId"]
    },
    "qr_tickets": {
      "title": "qr_tickets",
      "description": "QR Ticket Validation Records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketCode": { "type": "string" },
        "eventId": { "type": "string" },
        "status": { "type": "string" },
        "qrData": { "type": "string" },
        "assignedGate": { "type": "string" },
        "scannedAt": { "type": "string" }
      },
      "required": ["ticketCode", "eventId", "qrData"]
    },
    "promos": {
      "title": "promos",
      "description": "Promotional Discount Codes",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "active": { "type": "boolean" },
        "usedCount": { "type": "number" }
      },
      "required": ["code", "discountPercentage"]
    },
    "scan_records": {
      "title": "scan_records",
      "description": "Gate Check-in Scan Log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketCode": { "type": "string" },
        "gateName": { "type": "string" },
        "scannedAt": { "type": "string" },
        "attendeeName": { "type": "string" },
        "eventTitle": { "type": "string" },
        "tierName": { "type": "string" },
        "synced": { "type": "boolean" }
      },
      "required": ["ticketCode", "gateName", "scannedAt"]
    },
    "notifications": {
      "title": "notifications",
      "description": "Dispatched Notification Logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "ticketCode": { "type": "string" },
        "type": { "type": "string" },
        "recipient": { "type": "string" },
        "subject": { "type": "string" },
        "bodyPreview": { "type": "string" },
        "sentAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["orderId", "recipient", "type"]
    }
  }
}
