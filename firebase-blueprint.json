{
  "entities": {
    "events": {
      "title": "Events",
      "description": "Platform events listed by organizers",
      "properties": {
        "title": { "type": "string", "description": "Title of the event" },
        "organizer": { "type": "string", "description": "Organizer name" },
        "date": { "type": "string", "description": "Event date" },
        "time": { "type": "string", "description": "Event time" },
        "venue": { "type": "string", "description": "Venue name" },
        "city": { "type": "string", "description": "City" },
        "category": { "type": "string", "description": "Category" },
        "description": { "type": "string", "description": "Event description" },
        "image": { "type": "string", "description": "Thumbnail image URL" },
        "bannerImage": { "type": "string", "description": "Banner image URL" },
        "status": { "type": "string", "description": "Status (Published, Draft, Ended)" },
        "ticketsSold": { "type": "number", "description": "Total tickets sold" },
        "totalCapacity": { "type": "number", "description": "Total capacity" },
        "grossRevenue": { "type": "number", "description": "Gross revenue in Naira" }
      }
    },
    "orders": {
      "title": "Orders",
      "description": "Ticket purchase orders made by attendees",
      "properties": {
        "eventId": { "type": "string", "description": "ID of the event" },
        "eventTitle": { "type": "string", "description": "Title of the event" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerEmail": { "type": "string", "description": "Customer email" },
        "customerPhone": { "type": "string", "description": "Customer phone" },
        "ticketsCount": { "type": "number", "description": "Number of tickets" },
        "totalPaid": { "type": "number", "description": "Total amount paid" },
        "orderDate": { "type": "string", "description": "Order date" },
        "paymentMethod": { "type": "string", "description": "Payment method" },
        "status": { "type": "string", "description": "Order status" }
      }
    },
    "tickets": {
      "title": "Tickets",
      "description": "Issued event tickets for check-in",
      "properties": {
        "orderId": { "type": "string", "description": "Associated order ID" },
        "eventId": { "type": "string", "description": "Event ID" },
        "eventTitle": { "type": "string", "description": "Event title" },
        "tierName": { "type": "string", "description": "Ticket tier name" },
        "attendeeName": { "type": "string", "description": "Attendee full name" },
        "attendeeEmail": { "type": "string", "description": "Attendee email" },
        "attendeePhone": { "type": "string", "description": "Attendee phone" },
        "pricePaid": { "type": "number", "description": "Price paid" },
        "ticketCode": { "type": "string", "description": "Unique ticket code" },
        "status": { "type": "string", "description": "Status" },
        "checkedInAt": { "type": "string", "description": "Check-in timestamp" },
        "scannedByGate": { "type": "string", "description": "Gate name" }
      }
    },
    "qr_tickets": {
      "title": "QR Tickets",
      "description": "QR Ticket payload and fast-scan records",
      "properties": {
        "ticketCode": { "type": "string", "description": "Unique ticket code" },
        "eventId": { "type": "string", "description": "Event ID" },
        "status": { "type": "string", "description": "Status (VALID, CHECKED_IN, CANCELLED)" },
        "qrData": { "type": "string", "description": "Payload data for QR generation" },
        "assignedGate": { "type": "string", "description": "Gate assigned for check-in" },
        "scannedAt": { "type": "string", "description": "When the QR was scanned" }
      }
    },
    "users": {
      "title": "Users",
      "description": "Registered Ticketa attendees and customers",
      "properties": {
        "fullName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "description": "User's email address" },
        "phone": { "type": "string", "description": "User's phone number" },
        "registeredAt": { "type": "string", "description": "Account registration date" },
        "totalOrders": { "type": "number", "description": "Count of ticket orders placed" },
        "totalSpent": { "type": "number", "description": "Total amount spent on tickets" },
        "status": { "type": "string", "description": "Account status (Active, Verified)" }
      }
    },
    "organizers": {
      "title": "Organizers",
      "description": "Registered Ticketa event hosts and organization accounts",
      "properties": {
        "organizationName": { "type": "string", "description": "Organization or host name" },
        "email": { "type": "string", "description": "Organizer email" },
        "phone": { "type": "string", "description": "Organizer phone" },
        "category": { "type": "string", "description": "Host category" },
        "registeredAt": { "type": "string", "description": "Registration date" },
        "status": { "type": "string", "description": "Status (Active, Verified)" },
        "eventsCount": { "type": "number", "description": "Number of published events" }
      }
    }
  },
  "firestore": {
    "/events/{eventId}": { "schema": "events", "description": "Platform events" },
    "/orders/{orderId}": { "schema": "orders", "description": "Ticket orders" },
    "/tickets/{ticketId}": { "schema": "tickets", "description": "Purchased tickets" },
    "/qr_tickets/{qrTicketId}": { "schema": "qr_tickets", "description": "QR scan records and payloads" },
    "/users/{userId}": { "schema": "users", "description": "Attendee user profiles" },
    "/organizers/{organizerId}": { "schema": "organizers", "description": "Organizer user profiles" }
  }
}
